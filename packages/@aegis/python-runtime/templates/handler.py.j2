#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Aegis Exception Handler Template
Provides retry, skip, and abort strategies for automation steps.
"""

import json
import sys
import time
import traceback
import logging

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s"
)
logger = logging.getLogger(__name__)


def emit_result(operation_id, status, data=None, error=None):
    """Output structured JSON result for the TypeScript executor."""
    result = {
        "operation_id": operation_id,
        "status": status,
        "timestamp": __import__("datetime").datetime.utcnow().isoformat() + "Z",
    }
    if data is not None:
        result["data"] = data
    if error is not None:
        result["error"] = error
    print(json.dumps(result))


# ── Exception Handler Strategies ─────────────────────────────────

def retry(step_fn, max_retries=3, delay=1.0, operation_id="unknown"):
    """Retry a step function on failure.

    Args:
        step_fn: Callable to execute.
        max_retries: Maximum retry attempts.
        delay: Delay between retries in seconds.
        operation_id: For logging.

    Returns:
        Result of step_fn or raises after max_retries.
    """
    last_error = None
    for attempt in range(1, max_retries + 1):
        try:
            return step_fn()
        except Exception as e:
            last_error = e
            logger.warning(
                f"Step failed (attempt {attempt}/{max_retries}): {e}"
            )
            if attempt < max_retries:
                time.sleep(delay)
                delay *= 2  # Exponential backoff

    logger.error(f"Step failed after {max_retries} retries: {last_error}")
    raise last_error


def skip_on_error(step_fn, operation_id="unknown"):
    """Execute a step, logging and skipping on error.

    Args:
        step_fn: Callable to execute.
        operation_id: For logging.

    Returns:
        Result of step_fn or None if it failed.
    """
    try:
        return step_fn()
    except Exception as e:
        logger.warning(f"Step skipped due to error: {e}")
        return None


def abort_on_error(step_fn, operation_id="unknown"):
    """Execute a step, aborting the entire operation on error.

    Args:
        step_fn: Callable to execute.
        operation_id: For logging.

    Returns:
        Result of step_fn or exits on error.
    """
    try:
        return step_fn()
    except Exception as e:
        logger.error(f"Aborting operation {operation_id}: {e}")
        traceback.print_exc()
        emit_result(operation_id, "failed", error=str(e))
        sys.exit(1)


# ── Exception Handler Registry ───────────────────────────────────

HANDLER_STRATEGIES = {
    "retry": retry,
    "skip": skip_on_error,
    "abort": abort_on_error,
}


def get_handler(strategy: str):
    """Get an exception handler function by strategy name."""
    return HANDLER_STRATEGIES.get(strategy, abort_on_error)
