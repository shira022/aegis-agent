#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Aegis Browser Automation — Playwright Template
Task: {{ task_id }} | Source: browser | Steps: {{ step_count }}
"""

import json
import sys
import traceback
import logging

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s"
)
logger = logging.getLogger(__name__)

from playwright.sync_api import sync_playwright


def emit_result(operation_id, status, data=None, error=None):
    """Output structured JSON result for the TypeScript executor."""
    result = {
        "operation_id": operation_id,
        "status": status,
        "timestamp": __import__("datetime").datetime.utcnow().isoformat() + "Z",
    }
    if data is not None:
        result["data"] = data
    if error is not None:
        result["error"] = error
    print(json.dumps(result))


def capture_screenshot(page, name="screenshot"):
    """Capture a screenshot from a Playwright page."""
    path = f"{name}.png"
    page.screenshot(path=path)
    logger.info(f"Screenshot saved: {path}")
    return path


# ── User Code ────────────────────────────────────────────────────

# SCRIPT_PLACEHOLDER


def main():
    """Execute browser automation for operation {{ operation_id }}."""
    logger.info("Starting browser operation {{ operation_id }}")
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(headless=True)
            context = browser.new_context()
            page = context.new_page()

            run(page)

            browser.close()
        emit_result('{{ operation_id }}', 'completed', {'steps': {{ step_count }}})
    except Exception as e:
        logger.error(f"Browser operation failed: {e}")
        traceback.print_exc()
        emit_result('{{ operation_id }}', 'failed', error=str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
