#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Aegis Desktop Automation — pyautogui Template
Task: {{ task_id }} | Source: desktop | Steps: {{ step_count }}
"""

import json
import sys
import traceback
import logging
import time

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s"
)
logger = logging.getLogger(__name__)

import pyautogui


def emit_result(operation_id, status, data=None, error=None):
    """Output structured JSON result for the TypeScript executor."""
    result = {
        "operation_id": operation_id,
        "status": status,
        "timestamp": __import__("datetime").datetime.utcnow().isoformat() + "Z",
    }
    if data is not None:
        result["data"] = data
    if error is not None:
        result["error"] = error
    print(json.dumps(result))


# ── User Code ────────────────────────────────────────────────────

# SCRIPT_PLACEHOLDER


def main():
    """Execute desktop automation for operation {{ operation_id }}."""
    logger.info("Starting desktop operation {{ operation_id }}")
    try:
        run()
        emit_result('{{ operation_id }}', 'completed', {'steps': {{ step_count }}})
    except Exception as e:
        logger.error(f"Desktop operation failed: {e}")
        traceback.print_exc()
        emit_result('{{ operation_id }}', 'failed', error=str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
