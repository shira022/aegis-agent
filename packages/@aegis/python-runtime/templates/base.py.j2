def emit_result(operation_id, status, data=None, error=None):
    """Output structured JSON result for the TypeScript executor."""
    result = {
        "operation_id": operation_id,
        "status": status,
        "timestamp": __import__("datetime").datetime.utcnow().isoformat() + "Z",
    }
    if data is not None:
        result["data"] = data
    if error is not None:
        result["error"] = error
    print(json.dumps(result))


